{
  "name": "pretium",
  "private": true,
  "version": "0.1.0",
  "description": "Pretium — orçamento de obras com base SINAPI-RJ",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "node supabase/tests/core/core_run.mjs && PRETIUM_MIGRATIONS=all node supabase/tests/core/core_run.mjs && node supabase/tests/orcamento/orc_run.mjs",
    "test:db:pg": "node supabase/tests/pg_run.mjs",
    "test:contrato": "node scripts/verificar-contrato.mjs",
    "test:integracao": "node scripts/test-integracao.mjs",
    "test:e2e": "node scripts/e2e/rodar.mjs",
    "test:all": "npm run test && npm run test:db && npm run test:db:pg && npm run test:contrato && npm run test:integracao && npm run test:e2e",
    "lint": "eslint .",
    "types:gen": "supabase gen types typescript --local > src/types/database.generated.ts",
    "db:reset": "supabase db reset",
    "db:start": "supabase start"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.1",
    "@supabase/supabase-js": "^2.46.1",
    "@tanstack/react-query": "^5.59.20",
    "clsx": "^2.1.1",
    "fflate": "^0.8.2",
    "lucide-react": "^0.456.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.2",
    "react-router-dom": "^6.28.0",
    "recharts": "^2.13.3",
    "tailwind-merge": "^2.5.4",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@eslint/js": "^9.14.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.14.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^15.12.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.14.0",
    "vite": "^5.4.11",
    "vitest": "^2.1.5"
  }
}
