{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/sinapi/*.ts": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/sinapi/cron",
      "schedule": "17 13 * * *"
    }
  ]
}
